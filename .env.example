# ============================================================
# 环境变量配置文件
# 部署到服务器时，复制此文件为 .env 并修改相关配置
# ============================================================

# Django 配置
DJANGO_SECRET_KEY=django-insecure-please-change-this-to-a-random-secret-key
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,39.105.122.26

# 数据库配置（使用服务器上的 MySQL）
DB_NAME=wlw
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=39.105.122.26
DB_PORT=3306

# MQTT 配置（可选）
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# WebSocket 配置
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8001
